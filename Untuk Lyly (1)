@charset "utf-8";

body { margin: 0px; padding: 0px; min-height: 100vh; display: flex; justify-content: center; align-items: center; background: linear-gradient(135deg, rgb(255, 229, 236), rgb(255, 194, 209)); font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif; overflow: hidden; user-select: none; }

.container { text-align: center; position: relative; padding: 20px; }

.scan-wrapper { display: flex; flex-direction: column; align-items: center; justify-content: center; cursor: pointer; }

.scan-text { color: rgb(255, 77, 109); font-size: 16px; font-weight: bold; margin-bottom: 20px; letter-spacing: 1px; }

.fingerprint-btn { position: relative; width: 100px; height: 100px; background: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; box-shadow: rgba(255, 77, 109, 0.2) 0px 10px 25px; transition: transform 0.3s; }

.fingerprint-btn svg { width: 55px; height: 55px; fill: rgb(255, 77, 109); transition: fill 0.3s; }

.scanner-line { position: absolute; width: 80%; height: 4px; background-color: rgb(255, 77, 109); border-radius: 2px; top: 10%; left: 10%; opacity: 0; box-shadow: rgb(255, 77, 109) 0px 0px 8px; }

.scan-wrapper.holding .fingerprint-btn { transform: scale(0.95); background: rgb(255, 240, 243); }

.scan-wrapper.holding .scanner-line { opacity: 1; animation: 1s linear 0s infinite normal none running scanMove; }

@keyframes scanMove { 
  0%, 100% { top: 15%; }
  50% { top: 80%; }
}

.heart-content { display: none; opacity: 0; transition: opacity 0.8s; }

.show-content { display: block; opacity: 1; }

.heart { position: relative; width: 100px; height: 90px; margin: 0px auto 30px; background-color: rgb(255, 77, 109); transform: rotate(-45deg); animation: 0.8s ease 0s infinite alternate none running beat; box-shadow: rgba(255, 77, 109, 0.6) 0px 0px 40px; }

.heart::before, .heart::after { content: ""; position: absolute; width: 100px; height: 100px; background-color: rgb(255, 77, 109); border-radius: 50%; }

.heart::before { top: -50px; left: 0px; }

.heart::after { top: 0px; left: 50px; }

@keyframes beat { 
  0% { transform: rotate(-45deg) scale(1); }
  100% { transform: rotate(-45deg) scale(1.15); }
}

h1 { color: rgb(255, 77, 109); font-size: 26px; margin: 0px; text-shadow: rgba(0, 0, 0, 0.1) 1px 1px 2px; letter-spacing: 1px; min-height: 40px; }

.cursor { display: inline-block; background-color: rgb(255, 77, 109); width: 3px; height: 24px; margin-left: 4px; animation: 0.6s ease 0s infinite normal none running blink; vertical-align: middle; }

@keyframes blink { 
  0%, 100% { opacity: 1; }
  50% { opacity: 0; }
}
